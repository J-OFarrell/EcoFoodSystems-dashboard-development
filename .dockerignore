# Secrets - these must never be baked into the image. GROQ_API_KEY,
# DASH_USERNAME, DASH_PASSWORD are set as Hugging Face "Secrets" on the
# Space instead (injected as env vars at runtime), never committed here.
.env
.env.example

# Git itself - not needed inside the image, and large
.git
.gitignore

# cache/ is osmnx's own local download cache from an offline precompute
# step - confirmed nothing in the running app reads from it.
cache/

# assets/data/archive/ is mostly superseded data EXCEPT 4 small CSVs that
# hanoi_layouts.py's resilience tab genuinely still reads (confirmed via
# grep across the whole codebase, not assumed) - exclude the folder, then
# explicitly re-include exactly those 4 files. Docker requires walking back
# down the path with the parent directories re-included too, or the '!'
# re-includes below never get evaluated.
assets/data/archive/*
!assets/data/archive/hanoi
assets/data/archive/hanoi/*
!assets/data/archive/hanoi/resilience
assets/data/archive/hanoi/resilience/*
!assets/data/archive/hanoi/resilience/resilience_indicators_ref.csv
!assets/data/archive/hanoi/resilience/resilience_indicators_p1.csv
!assets/data/archive/hanoi/resilience/resilience_indicators_p2.csv
!assets/data/archive/hanoi/resilience/resilience_indicators_p3.csv

# Python build artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Local dev/test scratch, not part of the app
Claude outputs/
_index_response.html
_layout_response.json
_server_boot*.log
_server_verify.log

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
